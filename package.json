{
  "name": "sync-vault",
  "version": "0.1.0",
  "description": "Interactive TUI for transferring files over SFTP/SSH with rsync fallback — a friendlier replacement for ncftp",
  "type": "module",
  "bin": {
    "sync-vault": "./dist/sync-vault"
  },
  "scripts": {
    "dev": "bun run src/cli.tsx",
    "build": "bash scripts/build.sh",
    "test": "bun test",
    "lint": "biome check src",
    "format": "biome format --write src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ink": "^5.0.1",
    "ink-select-input": "^6.0.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "react": "^18.3.1",
    "ssh2": "^1.16.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/react": "^18.3.12",
    "@types/ssh2": "^1.15.1",
    "bun-types": "^1.3.14",
    "react-devtools-core": "^7.0.1",
    "typescript": "^5.6.3"
  },
  "engines": {
    "bun": ">=1.1.0"
  }
}
